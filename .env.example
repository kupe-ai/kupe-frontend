# Copy to .env. Flip VITE_MODE between dev and prod.
# Vite only exposes variables that start with VITE_.

VITE_MODE=dev

# CRUD API
VITE_BACKEND_URL_DEV=http://127.0.0.1:8000
VITE_BACKEND_URL_PROD=https://x.kupe.in

# Frontend itself is deployed at https://hub.kupe.in in prod.

# Supabase Auth + RLS (Dashboard → Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
