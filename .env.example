# Copy to .env. Flip VITE_MODE between dev and prod.
# Vite only exposes variables that start with VITE_.
#
# dev  → local CRUD at VITE_BACKEND_URL_DEV
# prod → https://x.kupe.in  (this frontend itself is hosted at https://hub.kupe.in)

VITE_MODE=dev

# CRUD API
VITE_BACKEND_URL_DEV=http://127.0.0.1:8000
VITE_BACKEND_URL_PROD=https://x.kupe.in

# Supabase Auth + RLS (Dashboard → Settings → API). Anon key only.
VITE_SUPABASE_URL=https://bwvcwpxcjixnmibwmfxw.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ3dmN3cHhjaml4bm1pYndtZnh3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY3NzA1OTQsImV4cCI6MjEwMjM0NjU5NH0.QriVumKxXieybJcCUCu3vZHYiWoUkVJbMDYxaR7mLns

# PostHog project token (phc_…). Never put a personal API key (phx_) here.
# Leave VITE_POSTHOG_HOST unset to use the /ingest same-origin proxy
# (see vercel.json + vite.config.ts) -- this keeps analytics working even
# when ad blockers block us.i.posthog.com directly. Only set it to a direct
# posthog.com URL if you're intentionally bypassing the proxy.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
